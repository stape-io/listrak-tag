- name: '[Access Token] Fetches and caches a token then reuses it without a second
    token request'
  code: |-
    let tokenRequests = 0;
    let apiRequests = 0;

    mock('sendHttpRequest', (url, options, body) => {
      if (url === 'https://auth.listrak.com/OAuth2/Token') {
        tokenRequests++;
        assertThat(options.method).isEqualTo('POST');
        assertThat(options.headers['Content-Type']).isEqualTo('application/x-www-form-urlencoded');
        assertThat(body).contains('grant_type=client_credentials');
        assertThat(body).contains('client_id=testClientId');
        assertThat(body).contains('client_secret=testClientSecret');
        return Promise.create((resolve) =>
          resolve({statusCode: 200, body: JSON.stringify({access_token: 'token-1', expires_in: 3600})})
        );
      }
      apiRequests++;
      assertThat(options.headers['Authorization']).isEqualTo('Bearer token-1');
      return Promise.create((resolve) => resolve({statusCode: 200, body: '{}'}));
    });

    runCode(mockData);

    callLater(() => {
      runCode(mockData);

      callLater(() => {
        assertThat(tokenRequests).isEqualTo(1);
        assertThat(apiRequests).isEqualTo(2);
        assertApi('gtmOnSuccess').wasCalled();
        assertApi('gtmOnFailure').wasNotCalled();
      });
    });
- name: '[Access Token] Refetches a new token after the cached token has expired'
  code: |-
    let tokenRequests = 0;

    mock('sendHttpRequest', (url) => {
      if (url === 'https://auth.listrak.com/OAuth2/Token') {
        tokenRequests++;
        return Promise.create((resolve) =>
          resolve({
            statusCode: 200,
            body: JSON.stringify({access_token: 'token-' + tokenRequests, expires_in: 60})
          })
        );
      }
      return Promise.create((resolve) => resolve({statusCode: 200, body: '{}'}));
    });

    mock('getTimestampMillis', 1712000000000);

    runCode(mockData);

    callLater(() => {
      mock('getTimestampMillis', 1712000000000 + 61 * 1000);

      runCode(mockData);

      callLater(() => {
        assertThat(tokenRequests).isEqualTo(2);
        assertApi('gtmOnSuccess').wasCalled();
        assertApi('gtmOnFailure').wasNotCalled();
      });
    });
